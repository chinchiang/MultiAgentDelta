{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "mcp__github__merge_pull_request",
      "mcp__github__actions_run_trigger",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push *+*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__fire_trigger",
      "mcp__github__enable_pr_auto_merge",
      "Bash(gh -R * pr merge*)",
      "Bash(gh --repo * pr merge*)",
      "Bash(curl *api.github.com*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git -C * push *)",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__update_pull_request_branch",
      "Bash(gh -R * workflow run*)",
      "mcp__github__pull_request_review_write",
      "Bash(gh pr review *)",
      "Bash(gh -R * pr review*)",
      "mcp__github__update_pull_request",
      "Bash(gh pr edit *)",
      "Bash(gh -R * pr edit*)"
    ],
    "allow": [
      "Bash(claude plugin validate *)",
      "Bash(gh run watch *)",
      "Bash(gh label list *)",
      "Bash(claude plugin list)",
      "Bash(python3 scripts/validate.py)",
      "Bash(python3 scripts/ci_invariants.py selftest)",
      "Bash(python3 scripts/vibesec_policy.py selftest)",
      "Bash(python3 scripts/g1_slopcheck.py selftest)",
      "Bash(python3 -I scripts/ci_validate.py --trusted /tmp/wt-main)",
      "Bash(python3 scripts/compare_evals.py *)",
      "Bash(python3 scripts/gate_result.py selftest)",
      "Bash(python3 scripts/g4_access.py selftest)",
      "Bash(python3 scripts/g4_review.py selftest)",
      "Bash(python3 scripts/bilingual.py selftest)",
      "Bash(python3 scripts/gate_verdict.py selftest)",
      "Bash(python3 -I scripts/compare_ci.py *)",
      "Bash(python3 scripts/g0_threat_model.py selftest)",
      "Bash(python3 scripts/g1_kev.py selftest)",
      "Bash(python3 scripts/g1_provenance.py selftest)",
      "Bash(python3 scripts/g1_maintenance.py selftest)"
    ]
  }
}
