{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinchiang/MultiAgentDelta/schemas/human-ruling.schema.json",
  "title": "VibeSec Human Ruling",
  "description": "人工對 requires_human 發現的裁決紀錄（docs/09 §7）。只決定 validation_status 與（有證據時）evidence_grade；不改嚴重度、CVSS、policy_tier，也不刪除任何模型意見。",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruling_version", "finding_id", "decided_by", "decided_at", "decision", "basis", "rationale", "minority_acknowledged"],
  "properties": {
    "ruling_version": { "const": 1 },
    "finding_id": { "type": "string", "pattern": "^VS-[0-9]{8}-[0-9a-f]{8}$" },
    "decided_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "handle", "role"],
      "properties": {
        "type": { "const": "human", "description": "裁決者必須是人；模型或 bot 不得裁決" },
        "handle": { "type": "string", "minLength": 2, "description": "GitHub 帳號或工號" },
        "role": { "type": "string", "minLength": 2, "description": "例如 appsec-lead、tech-lead" }
      }
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "decision": {
      "type": "string",
      "enum": ["confirm", "refute", "defer"],
      "description": "confirm → validation_status confirmed 且 E3；refute → refuted；defer → 維持 pending 並保留 requires_human"
    },
    "basis": {
      "type": "string",
      "enum": ["reproduced", "manual_review", "scope_exclusion", "compensating_control", "insufficient_evidence"],
      "description": "裁決依據。模型共識不是依據（docs/09 §4）"
    },
    "evidence_refs": {
      "type": "array",
      "description": "裁決所依據的證據；model_review 不算",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "enum": ["tool_output", "http_exchange", "code_excerpt", "advisory", "human_note", "trace"] },
          "ref": { "type": "string", "minLength": 1 },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 20, "description": "為什麼這樣裁決；需回應分歧點" },
    "minority_acknowledged": {
      "type": "array",
      "description": "finding 中每一則 minority 意見都必須逐一回應",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "provider", "response"],
        "properties": {
          "role": { "type": "string", "enum": ["architecture", "appsec", "identity-authz", "supplychain-cicd"] },
          "provider": { "type": "string" },
          "response": { "type": "string", "enum": ["accepted", "rejected"], "description": "accepted = 採納其論點；rejected = 不採納" },
          "comment": { "type": ["string", "null"] }
        }
      }
    },
    "next_review_by": { "type": ["string", "null"], "format": "date", "description": "decision=defer 時必填" },
    "follow_up": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": ["string", "null"] },
        "due_date": { "type": ["string", "null"], "format": "date" },
        "ticket": { "type": ["string", "null"] }
      }
    }
  }
}
